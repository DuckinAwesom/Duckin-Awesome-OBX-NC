/* Hamburger menu */
.menu-toggle {
  position: fixed;
  top: 20px;
  left: 20px;
  font-size: 30px;
  cursor: pointer;
  z-index: 1000;
}

nav#side-menu {
  position: fixed;
  top: 0;
  left: -200px;
  width: 200px;
  height: 100%;
  background: #006d77;
  color: white;
  display: flex;
  flex-direction: column;
  padding-top: 60px;
  transition: left 0.3s ease;
}

nav#side-menu a {
  color: white;
  padding: 15px;
  text-decoration: none;
  font-weight: bold;
}

